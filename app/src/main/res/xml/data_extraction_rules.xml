<?xml version="1.0" encoding="utf-8"?>
<!--
   Автоматическая копия Android 12+ и перенос на новый телефон: база задач и настройки.
   Своя копия в Google Drive — DriveBackupManager; эта — запасная, её восстанавливает система.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="things_database" />
        <include domain="database" path="things_database-wal" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="things_database" />
        <include domain="database" path="things_database-wal" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
